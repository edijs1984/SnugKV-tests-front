{
  "name": "snugkv-tests-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run electron:dev",
    "dev:web": "vite",
    "electron:dev": "concurrently -k -n web,electron \"vite\" \"wait-on tcp:5173 && electron --no-sandbox .\"",
    "build": "tsc -b && vite build",
    "electron:dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.snugkv.benchmarklab",
    "productName": "SnugKV Benchmark Lab",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
