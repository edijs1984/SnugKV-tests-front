{
  "name": "snugkv-tests-front",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "npm run electron:dev",
    "dev:web": "vite",
    "electron:dev": "concurrently -k -n web,electron \"vite\" \"wait-on tcp:5173 && electron --no-sandbox .\"",
    "build": "tsc -b && vite build",
    "electron:dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.snugkv.benchmarklab",
    "productName": "SnugKV Benchmark Lab",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icons/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.svg",
      "synopsis": "Redis-compatible benchmark tool for SnugKV",
      "description": "Desktop benchmark lab for Redis, SnugKV raw and SnugKV optimized.",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Skv Benchmark Lab",
          "Comment": "Benchmark Redis and SnugKV locally",
          "Categories": "Development;Utility",
          "Keywords": "redis;snugkv;benchmark;database;performance",
          "Terminal": false,
          "Type": "Application"
        }
      }
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    },
    "executableName": "skv-benchmark-lab"
  },
  "description": "Desktop benchmark lab for Redis and SnugKV.",
  "author": {
    "name": "Edijs Ziedins",
    "email": "46107922+edijs1984@users.noreply.github.com"
  },
  "desktopName": "dev.snugkv.benchmarklab.desktop"
}
